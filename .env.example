# Ключ для жюри (заголовок X-API-Key). Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(24))"
API_KEY=change-me
# Частота выборки кадров для анализа (кадров/сек)
SAMPLE_FPS=4
# Сколько видео обрабатывать параллельно
WORKERS=1
# Порог срабатывания детектора (если не задан — берётся из models/detector.joblib)
# DETECTOR_THRESHOLD=0.5
# Вход в веб-интерфейс. Строку печатает: python scripts/make_user.py <логин>
UI_USERS=
# Секрет подписи сессий: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
# Тестовая учётка для жюри: показывается на экране входа. Включать только на время проверки!
UI_DEMO_LOGIN=
UI_DEMO_PASSWORD=
# Анализатор: gemini — облачный (Gemini API, использование согласовано с жюри), local — CLIP + детектор, офлайн
ANALYZER=gemini
# Доступ к Gemini — одно из двух (в git не коммитить!):
#  1) Vertex AI через сервисный аккаунт — платные квоты проекта, ~10 с на ролик (рекомендуется)
GOOGLE_APPLICATION_CREDENTIALS=
#  2) ключ Gemini API (https://aistudio.google.com/apikey); на бесплатном проекте всего 20 запросов в сутки на модель
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Уровень размышлений: пусто — по умолчанию (точнее), low — быстрее, но больше ложных тревог
# GEMINI_THINKING=low
